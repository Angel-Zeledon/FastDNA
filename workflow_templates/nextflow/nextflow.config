// nextflow.config -- default parameters for the FastDNA cohort k-mer
// counting pipeline (main.nf).
//
// Override any of these on the command line (e.g. `--fastq_dir my_data/`)
// or with your own `-params-file`/`-c` config -- main.nf itself should not
// need editing for a typical run.

params {
    // Directory of paired-end FASTQ(.gz) files, one pair per sample, named
    // "<sample>_R1.fastq.gz" / "<sample>_R2.fastq.gz" -- see this
    // directory's README.md for the exact convention `main.nf`'s
    // `Channel.fromFilePairs` glob expects.
    fastq_dir   = 'data'

    // Where per-sample Parquet counts, per-sample QC JSON, and the final
    // cohort-combined k-mer table are published.
    output_dir  = 'results'

    // fastdna count's own flags -- see the main repository README.md's
    // "Flags" table for exactly what each one does.
    k           = 31
    min_quality = 20.0
    min_count   = 1
    threads     = 4

    // How `fastdna union` folds several samples' counts for the same k-mer
    // into the cohort table's single `frequency` column: "sum" (the
    // natural "combine this cohort" reading), "min", or "max" -- see the
    // main repository README.md's `fastdna union --combine` documentation.
    combine     = 'sum'
}

process {
    // Local execution by default so this template runs out of the box on a
    // single machine; override the executor (e.g. 'slurm', 'awsbatch') via
    // -profile or a site config for cluster/cloud use -- nothing in main.nf
    // depends on which executor actually runs it.
    executor = 'local'
    cpus     = params.threads
}
